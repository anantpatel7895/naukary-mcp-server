# Copy to .env and edit. Every value is optional -- the defaults are safe.

# --- storage ---------------------------------------------------------------
# Blank uses SQLite at ~/.naukri-mcp/jobs.db. For Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/naukri
DATABASE_URL=
DATA_DIR=~/.naukri-mcp

# --- safety ----------------------------------------------------------------
# true  = emails are drafted and logged to the DB but never handed to SMTP.
# false = real sends. Leave this on until you have seen a draft you are happy with.
DRY_RUN=true

# --- Naukri provider (optional, opt-in) ------------------------------------
# Step-by-step setup: docs/naukri-session.md
# Naukri has no public API, its Terms prohibit automated access, and its robots.txt
# disallows AI agents. This uses your own logged-in session at one request per ~3s.
# Everything else in this server works without it.
NAUKRI_ENABLED=false

# The WHOLE Cookie request header from a logged-in naukri.com tab:
#   DevTools > Network > filter Fetch/XHR + "jobapi" > click a request >
#   Request Headers > Cookie > copy value
# One line, unquoted, no "Cookie:" prefix. Expect to refresh this periodically.
NAUKRI_COOKIE=

# Optional. Only if that same request also shows an Authorization header.
# Leave blank otherwise. "Bearer " prefix is optional.
NAUKRI_AUTH_TOKEN=

# Verify a paste with: uv run python -m naukri_mcp.check_session --live
NAUKRI_RATE_LIMIT_RPS=0.33
NAUKRI_CACHE_TTL_SECONDS=900

# --- email -----------------------------------------------------------------
# Gmail: use a 16-character App Password (needs 2FA), never your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
FROM_EMAIL=
FROM_NAME=

# --- optional headless LLM providers ---------------------------------------
# Not needed for normal use: your MCP client (Claude Desktop / Claude Code) writes the
# tailored bullets. These are only for future unattended runs.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
